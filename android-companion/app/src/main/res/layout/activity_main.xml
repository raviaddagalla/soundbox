<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:padding="16dp">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Soundless UPI"
            android:textColor="@color/charcoal_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textServiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E0E7FF"
            android:textColor="@color/primary_indigo"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Active"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Permission Warning Banner Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#FCD34D"
        app:cardBackgroundColor="#FFFBEB"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textPermissionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification Access Required"
                android:textColor="#92400E"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPermissionDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/permission_desc"
                android:textColor="#78350F"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGrantPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/primary_indigo"
                android:text="Open Android Notification Settings"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Diagnostic Health Summary Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/cardPermission">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Companion State"
                android:textColor="@color/charcoal_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Local WebSocket Bridge:"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textBridgePort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ws://127.0.0.1:8765"
                    android:textColor="@color/primary_indigo"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Android TTS Engine:"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textTtsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ready (hi-IN / en-IN)"
                    android:textColor="@color/emerald_green"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnTestVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#F1F5F9"
                android:text="Test Android TTS Voice Output"
                android:textAllCaps="false"
                android:textColor="@color/charcoal_text"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Recent Processed Notifications Header -->
    <TextView
        android:id="@+id/textLogsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Recent Processed Events"
        android:textColor="@color/charcoal_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cardDiagnostics"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textLogsTitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/textEventLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="12dp"
            android:textColor="#334155"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="Soundless Companion initialized.\nWaiting for payment notifications..." />
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
